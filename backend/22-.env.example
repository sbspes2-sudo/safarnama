# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API keys.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon public key - newer Supabase dashboards call it the "publishable"
# key (sb_publishable_...). It is safe for read-only use because the RLS
# policies in supabase/schema.sql decide what is readable. Do NOT use the
# service_role (secret) key here; this API does not need it.
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Optional: port the API listens on locally (default 3001)
PORT=3001
# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow any origin while you are developing.
# ALLOWED_ORIGINS=https://your-site.com,http://localhost:8080
